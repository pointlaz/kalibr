SCANNER_SN=<serial_number>

# Host user/group ids for the kalibr-slim image, so files written to mounted
# volumes are owned by you (fill with the output of `id -u` and `id -g`).
USER_UID=1000
USER_GID=1000

# kalibr-worker volumes: jobs dir (job.yaml/status.yaml exchange) and data dir
# (where input MCAPs live, mounted read-side at /data in the container).
KALIBR_JOBS_DIR=./jobs
KALIBR_DATA_DIR=./jobs

# Calibration parameters
CAMERA_MODEL=pinhole
DISTORTION_MODEL=radtan
MUTUAL_INFORMATION_TOLERANCE=0.1
