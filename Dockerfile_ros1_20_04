# Same numpy pin as the builder stage — numpy_eigen's boost.python bridge is
# compiled against numpy's C API, so runtime numpy must stay ABI-compatible
# with whatever the builder stage resolved (also <1.25).
RUN pip3 install --no-cache-dir "numpy<1.25" mcap

RUN groupadd --gid $USER_GID $USERNAME \
	&& useradd -s /bin/bash --uid $USER_UID --gid $USER_GID -m $USERNAME \
	&& echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME \
	&& chmod 0440 /etc/sudoers.d/$USERNAME

USER $USERNAME

ENV WORKSPACE=/home/$USERNAME/catkin_ws

# devel/lib/<pkg>/<script> are symlinks into devel/.private/<pkg>/lib/... —
# catkin's isolated-devel-space layout — so both trees are needed for the
# compiled boost.python bindings (real files live under devel/.private).
COPY --from=builder --chown=$USER_UID:$USER_GID ${WORKSPACE}/devel/lib ${WORKSPACE}/devel/lib
COPY --from=builder --chown=$USER_UID:$USER_GID ${WORKSPACE}/devel/.private ${WORKSPACE}/devel/.private

# Every catkin_python_setup()-based pure-Python package in this workspace
# (not just kalibr's own) is installed into devel space as a "develop mode"
# trampoline that resolves multi-file packages back into $WORKSPACE/src at
# runtime — which this ROS-free stage never has (only single-file packages
# like aslam_cv_backend/incremental_calibration, whose whole implementation
# lives directly in __init__.py, work via the devel/.private copy alone).
# Bypass the trampoline by overlaying the real source for every such package
# straight from the build context. This is a MERGE, not a replace — each of
# these directories already has its compiled .so binding symlinked in from
# the devel/.private copy above (e.g. aslam_cv/libaslam_cv_python.so); COPY
# onto an existing directory adds/overwrites files by name without deleting
# what's already there, so the .so symlinks survive untouched.
RUN rm -rf ${WORKSPACE}/devel/lib/kalibr
COPY --chown=$USER_UID:$USER_GID aslam_optimizer/aslam_backend_python/python/aslam_backend ${WORKSPACE}/devel/lib/python3/dist-packages/aslam_backend
COPY --chown=$USER_UID:$USER_GID aslam_cv/aslam_cameras_april/python/aslam_cameras_april ${WORKSPACE}/devel/lib/python3/dist-packages/aslam_cameras_april
COPY --chown=$USER_UID:$USER_GID aslam_cv/aslam_cv_python/python/aslam_cv ${WORKSPACE}/devel/lib/python3/dist-packages/aslam_cv
COPY --chown=$USER_UID:$USER_GID aslam_cv/aslam_cv_backend_python/python/aslam_cv_backend ${WORKSPACE}/devel/lib/python3/dist-packages/aslam_cv_backend
COPY --chown=$USER_UID:$USER_GID aslam_nonparametric_estimation/aslam_splines_python/python/aslam_splines ${WORKSPACE}/devel/lib/python3/dist-packages/aslam_splines
COPY --chown=$USER_UID:$USER_GID aslam_nonparametric_estimation/bsplines_python/python/bsplines ${WORKSPACE}/devel/lib/python3/dist-packages/bsplines
COPY --chown=$USER_UID:$USER_GID aslam_incremental_calibration/incremental_calibration_python/src/incremental_calibration ${WORKSPACE}/devel/lib/python3/dist-packages/incremental_calibration
COPY --chown=$USER_UID:$USER_GID aslam_offline_calibration/kalibr/python/kalibr_common ${WORKSPACE}/devel/lib/python3/dist-packages/kalibr_common
COPY --chown=$USER_UID:$USER_GID aslam_offline_calibration/kalibr/python/kalibr_camera_calibration ${WORKSPACE}/devel/lib/python3/dist-packages/kalibr_camera_calibration
COPY --chown=$USER_UID:$USER_GID aslam_offline_calibration/kalibr/python/kalibr_errorterms ${WORKSPACE}/devel/lib/python3/dist-packages/kalibr_errorterms
COPY --chown=$USER_UID:$USER_GID aslam_offline_calibration/kalibr/python/kalibr_imu_camera_calibration ${WORKSPACE}/devel/lib/python3/dist-packages/kalibr_imu_camera_calibration
COPY --chown=$USER_UID:$USER_GID aslam_offline_calibration/kalibr/python/kalibr_rs_camera_calibration ${WORKSPACE}/devel/lib/python3/dist-packages/kalibr_rs_camera_calibration
COPY --chown=$USER_UID:$USER_GID Schweizer-Messer/numpy_eigen/src/numpy_eigen ${WORKSPACE}/devel/lib/python3/dist-packages/numpy_eigen
COPY --chown=$USER_UID:$USER_GID Schweizer-Messer/sm_python/python/sm ${WORKSPACE}/devel/lib/python3/dist-packages/sm
COPY --chown=$USER_UID:$USER_GID aslam_optimizer/sparse_block_matrix/src/sparse_block_matrix ${WORKSPACE}/devel/lib/python3/dist-packages/sparse_block_matrix
